# Used by docker-compose.yml (backend service). Copy to .env and set a real
# secret before running `docker compose up` - docker compose picks .env up
# automatically. The backend refuses to start without this (K-01: a known
# default secret would let anyone forge an admin token).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: fixes the one-time setup token instead of letting the backend
# generate and log a random one on first start (see `docker compose logs
# backend` for "SETUP TOKEN" if you leave this unset). Only useful for
# scripted/unattended deploys.
# SETUP_TOKEN=

# Optional: only used to build the clickable setup-token link in that same
# log message. Set this to the address you'll actually open the wizard
# from if it's not this machine, e.g. http://192.168.1.50:5173.
# FRONTEND_URL=http://localhost:5173

# Host-side port for Postgres (debugging only - backend/migrate always
# reach it internally at db:5432 regardless of this). Only needed if the
# default 15432 also collides with something already running on the host.
# DB_HOST_PORT=15432

# Beta diagnostics: stores client/device debug events and server-side
# gameplay/socket/audio events for later `/adolar-checklog` analysis.
# Enable only during beta/test sessions.
# BETA_DEBUG_LOGGING=true
# VITE_BETA_DEBUG_LOGGING=true
