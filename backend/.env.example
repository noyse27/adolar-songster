PORT=4000
DATABASE_URL=postgres://songster:songster@localhost:5432/adolar_songster
# Required (K-01): generate with `openssl rand -hex 32`. The backend
# refuses to start without a real secret here.
JWT_SECRET=
# Optional: fixes the one-time setup-wizard token instead of letting the
# backend generate and log a random one on first start.
# SETUP_TOKEN=
# Optional: builds the clickable link in that log message. Defaults to
# http://localhost:5173 (the Vite dev server).
# FRONTEND_URL=http://localhost:5173

# Adolar integration (see docs/Adolar_Songster_Adolar_Integration_Konzept_v1_20260821.md).
# Only needed for tables created with a sourcePlaylistId; ADOLAR_API_TOKEN is
# a Bearer API token created via Adolar Web's admin settings with product=songster.
ADOLAR_BASE_URL=http://localhost:5000
ADOLAR_API_TOKEN=
ADOLAR_CLIENT_VERSION=0.1.0
