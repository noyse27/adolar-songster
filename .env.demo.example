# Used by docker-compose.demo.yml. Copy to .env.demo and run:
#   docker compose -p adolar-songster-demo --env-file .env.demo -f docker-compose.demo.yml up -d --build
# See docs/demo.md for the full write-up of what demo mode does and why.

# Required, same as the real deployment's .env - generate with:
#   openssl rand -hex 32
JWT_SECRET=

# How often the demo database resets (wipes every account/table/game and
# reseeds the fixed demo admin, a standing invite code, and the synthetic
# song library). Minutes, clamped to [5, 1440] by the backend. Default: 60.
# DEMO_RESET_MINUTES=60

# Fixed demo login, printed on the demo site's own banner - not a secret,
# only override these if you're running more than one demo stack and want
# to tell them apart.
# DEMO_ADMIN_USERNAME=demo-admin
# DEMO_ADMIN_EMAIL=demo-admin@example.invalid
# DEMO_ADMIN_PASSWORD=songster-demo

# Standing invite code visitors use to self-register (also shown on the
# banner). Regenerated with every reset, so changing this mid-run only
# takes effect after the container restarts.
# DEMO_INVITE_CODE=demo

# Host-side ports. Defaults are deliberately different from
# docker-compose.yml's (5173/15432) so a demo stack can run alongside a
# real adolar-songster instance on the same host without any override
# needed.
# FRONTEND_HOST_PORT=5176
# DB_HOST_PORT=15434

# Only used to build the clickable setup-token link in the backend's
# startup log - irrelevant in demo mode since the demo admin account
# always exists already, kept here only for parity with .env.example.
# FRONTEND_URL=http://localhost:5176

# Length (seconds) of each synthetic demo song the "demo-songs" one-shot
# service renders on first startup (see demo/generate-library.sh).
# DEMO_SONG_SECONDS=25

# Beta diagnostics, same as .env.example.
# BETA_DEBUG_LOGGING=true
# VITE_BETA_DEBUG_LOGGING=true
